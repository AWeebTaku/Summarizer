<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-machine MSI (Program Files). WiX resolves relative paths from the working directory, so the
     folders are passed in as absolute paths. Build (from the repo root):
     wix build packaging\windows\summarizer.wxs -arch x64 -d Version=2.0.0 -d BundleDir=C:\path\to\dist\Summarizer -d IconFile=C:\path\to\packaging\icons\icon.ico -o release\Summarizer.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Summarizer" Manufacturer="Aditya Chaurasiya" Version="$(Version)"
           UpgradeCode="B5545314-F242-4DB7-8EAD-6B247A794927" Language="1033" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Summarizer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AWeebTaku/Summarizer" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Summarizer" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Summarizer" />
    </StandardDirectory>

    <!-- every file of the frozen app -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(BundleDir)\**" />
    </ComponentGroup>

    <!-- the Start menu entry, removed again on uninstall -->
    <ComponentGroup Id="Shortcuts" Directory="StartMenuDir">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Summarizer" Target="[INSTALLFOLDER]Summarizer.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Summarizer" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Summarizer" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
